{
	"_comment": "The PureBasic IDE's own Monokai scheme (colorschemes/Monokai.prefs; the live values are in ~/.purebasic/purebasic.prefs) mapped onto this grammar's scopes. The extension ships no colour opinions at all, so this is OPT IN: paste it into editor.tokenColorCustomizations.textMateRules if you want the IDE's exact palette back. Note the source.purebasic prefix on every selector -- a [purebasic] block is ignored for token colours.",
	"_verify": "Every selector below is a scope syntaxes/purebasic.tmLanguage.json actually emits; see the scope table in README.md.",
	"textMateRules": [
		{
			"_": "NormalTextColor. The base scope catches everything no other rule claims: a name on its own, punctuation.",
			"scope": [
				"source.purebasic"
			],
			"settings": {
				"foreground": "#F8F8F2"
			}
		},
		{
			"_": "BasicKeywordColor (Directives included) and OperatorColor",
			"scope": [
				"source.purebasic keyword.control.purebasic",
				"source.purebasic keyword.other.purebasic",
				"source.purebasic keyword.other.preprocessor.purebasic",
				"source.purebasic keyword.operator.purebasic"
			],
			"settings": {
				"foreground": "#F92672"
			}
		},
		{
			"_": "PureKeywordColor: the library commands, a procedure at its declaration, and a call of one",
			"scope": [
				"source.purebasic entity.name.function.purebasic"
			],
			"settings": {
				"foreground": "#A6E22E"
			}
		},
		{
			"_": "StringColor. The IDE colours an escape sequence with its string, too.",
			"scope": [
				"source.purebasic string",
				"source.purebasic constant.character.escape.purebasic"
			],
			"settings": {
				"foreground": "#E6DB74"
			}
		},
		{
			"_": "CommentColor",
			"scope": [
				"source.purebasic comment"
			],
			"settings": {
				"foreground": "#75715E"
			}
		},
		{
			"_": "ASMKeywordColor: an inline-assembly line, `! mov eax, 1`",
			"scope": [
				"source.purebasic meta.embedded.asm.purebasic"
			],
			"settings": {
				"foreground": "#66D9EF"
			}
		},
		{
			"_": "LabelColor: a code label and a `?label` reference to one",
			"scope": [
				"source.purebasic entity.name.label.purebasic",
				"source.purebasic variable.other.label-reference.purebasic"
			],
			"settings": {
				"foreground": "#E69F66"
			}
		},
		{
			"_": "ConstantColor, NumberColor and PointerColor are one value in this scheme, and a `@reference` wears it too",
			"scope": [
				"source.purebasic constant.other.predefined.purebasic",
				"source.purebasic constant.language.boolean.purebasic",
				"source.purebasic constant.language.null.purebasic",
				"source.purebasic constant.numeric.decimal.purebasic",
				"source.purebasic constant.numeric.hex.purebasic",
				"source.purebasic constant.numeric.bin.purebasic",
				"source.purebasic constant.numeric.float.purebasic",
				"source.purebasic constant.other.pointer.purebasic",
				"source.purebasic constant.other.reference.purebasic"
			],
			"settings": {
				"foreground": "#AE81FF"
			}
		},
		{
			"_": "StructureColor and ModuleColor. A USE of a type is coloured and its DECLARATION is not (see the last rule), so `Structure my_test` stays plain while `test.my_test` and `test\\age` do not -- which is what the IDE does.",
			"scope": [
				"source.purebasic entity.name.type.reference.purebasic",
				"source.purebasic entity.name.type.member.purebasic",
				"source.purebasic entity.name.namespace.purebasic"
			],
			"settings": {
				"foreground": "#A6E22E"
			}
		},
		{
			"_": "A declaration is normal text in the IDE: `Structure Point`, the name of a Module, a native `.i` suffix",
			"scope": [
				"source.purebasic entity.name.type.purebasic",
				"source.purebasic storage.type.purebasic"
			],
			"settings": {
				"foreground": "#F8F8F2"
			}
		},
		{
			"_": "SeparatorColor: the `:` that separates two statements. The IDE's value is #F8F8F0, a hair off its normal text.",
			"scope": [
				"source.purebasic punctuation.separator.statement.purebasic"
			],
			"settings": {
				"foreground": "#F8F8F0"
			}
		}
	]
}
