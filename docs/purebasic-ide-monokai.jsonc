{
	"_comment": "The PureBasic IDE's Monokai scheme (colorschemes/Monokai.prefs, live values in ~/.purebasic/purebasic.prefs) mapped onto this grammar's scopes. Paste into editor.tokenColorCustomizations.textMateRules to pin these colours over any theme; note the source.purebasic prefix, because a [purebasic] block is ignored for token colours.",
	"textMateRules": [
		{
			"_": "NormalTextColor: names on their own, punctuation",
			"scope": [
				"source.purebasic"
			],
			"settings": {
				"foreground": "#F8F8F2"
			}
		},
		{
			"_": "BasicKeywordColor and OperatorColor",
			"scope": [
				"source.purebasic keyword.control.purebasic",
				"source.purebasic keyword.operator.purebasic"
			],
			"settings": {
				"foreground": "#F92672"
			}
		},
		{
			"_": "PureKeywordColor: library commands, procedure names",
			"scope": [
				"source.purebasic support.function.purebasic",
				"source.purebasic entity.name.function.purebasic"
			],
			"settings": {
				"foreground": "#A6E22E"
			}
		},
		{
			"_": "StringColor, escape included",
			"scope": [
				"source.purebasic string",
				"source.purebasic constant.character.escape.purebasic"
			],
			"settings": {
				"foreground": "#E6DB74"
			}
		},
		{
			"_": "CommentColor",
			"scope": [
				"source.purebasic comment"
			],
			"settings": {
				"foreground": "#75715E"
			}
		},
		{
			"_": "ASMKeywordColor",
			"scope": [
				"source.purebasic meta.embedded.asm.purebasic"
			],
			"settings": {
				"foreground": "#66D9EF"
			}
		},
		{
			"_": "LabelColor",
			"scope": [
				"source.purebasic entity.name.label.purebasic",
				"source.purebasic variable.other.label-reference.purebasic"
			],
			"settings": {
				"foreground": "#E69F66"
			}
		},
		{
			"_": "ConstantColor, NumberColor and PointerColor are one value in this scheme",
			"scope": [
				"source.purebasic constant.other.predefined.purebasic",
				"source.purebasic constant.language.boolean.purebasic",
				"source.purebasic constant.language.null.purebasic",
				"source.purebasic constant.numeric.decimal.purebasic",
				"source.purebasic constant.numeric.hex.purebasic",
				"source.purebasic constant.numeric.bin.purebasic",
				"source.purebasic constant.numeric.float.purebasic",
				"source.purebasic variable.other.pointer.purebasic",
				"source.purebasic variable.other.reference.purebasic"
			],
			"settings": {
				"foreground": "#AE81FF"
			}
		},
		{
			"_": "StructureColor and ModuleColor: what comes off a structure",
			"scope": [
				"source.purebasic entity.name.type.reference.purebasic",
				"source.purebasic variable.other.member.purebasic",
				"source.purebasic variable.other.typed.purebasic",
				"source.purebasic entity.name.namespace.purebasic"
			],
			"settings": {
				"foreground": "#A6E22E"
			}
		},
		{
			"_": "A declaration is normal text in the IDE: `Structure Point`, a native suffix",
			"scope": [
				"source.purebasic entity.name.type.purebasic",
				"source.purebasic storage.type.purebasic",
				"source.purebasic keyword.other.purebasic",
				"source.purebasic meta.preprocessor.purebasic"
			],
			"settings": {
				"foreground": "#F8F8F2"
			}
		}
	]
}
